            "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta http-equiv=\"x-ua-compatible\" content=\"ie=edge\" />\n    <title>JavaScript Demo: JSON.parse()</title>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <link href=\"../../css/codemirror.css?v=1cd199c\" rel=\"stylesheet\" />\n    <link href=\"../../css/editor-js.css?v=1cd199c\" rel=\"stylesheet\" />\n  </head>\n\n  <body>\n    <section id=\"static\"><pre><code id=\"static-js\" data-height=\"\">const json = '{\"result\":true, \"count\":42}';\nconst obj = JSON.parse(json);\n\nconsole.log(obj.count);\n// Expected output: 42\n\nconsole.log(obj.result);\n// Expected output: true\n</code></pre></section>\n\n    <section id=\"live\" class=\"live hidden\">\n      <header class=\"output-header border-rounded-top-no-bottom\">\n        <h4 class=\"output-heading\">JavaScript Demo: JSON.parse()</h4>\n      </header>\n      <div id=\"editor\" class=\"editor\"></div>\n\n      <div class=\"output-container\">\n        <div class=\"buttons-container\">\n          <button id=\"execute\" class=\"button run\" type=\"button\">\n            Run &rsaquo;\n          </button>\n          <button id=\"reset\" type=\"button\" class=\"button\">Reset</button>\n        </div>\n        <div id=\"console\" class=\"output\"><code></code></div>\n      </div>\n    </section>\n\n    <script src=\"../../js/codemirror.js?v=1cd199c\"></script>\n    <script src=\"../../js/editor-js.js?v=1cd199c\"></script>\n  </body>\n</html>\n"
